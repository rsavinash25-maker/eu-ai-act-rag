// EU AI Act test set. Run  python check_questions.py  after editing: it confirms every evidence phrase exists in the index.
// Answers reflect the consolidated text (Regulation (EU) 2024/1689 as amended by Regulation (EU) 2026/1744).
{"id": "q01", "type": "lookup", "question": "What is the maximum fine for engaging in a prohibited AI practice?", "expected_answer": "Up to EUR 35 000 000 or, for an undertaking, up to 7% of its total worldwide annual turnover for the preceding financial year, whichever is higher (Article 99(3)).", "expected_evidence": "7 % of its total worldwide annual turnover", "answerable": true}
{"id": "q02", "type": "lookup", "question": "What fine applies when an operator breaches AI Act obligations other than the prohibitions?", "expected_answer": "Up to EUR 15 000 000 or, for an undertaking, up to 3% of total worldwide annual turnover for the preceding financial year, whichever is higher (Article 99(4)).", "expected_evidence": "3 % of its total worldwide annual turnover", "answerable": true}
{"id": "q03", "type": "lookup", "question": "What is the penalty for giving incorrect or misleading information to national authorities?", "expected_answer": "Up to EUR 7 500 000 or, for an undertaking, up to 1% of total worldwide annual turnover, whichever is higher (Article 99(5)).", "expected_evidence": "incorrect, incomplete or misleading information", "answerable": true}
{"id": "q04", "type": "lookup", "question": "How much can the Commission fine providers of general-purpose AI models?", "expected_answer": "Up to 3% of their annual total worldwide turnover in the preceding financial year or EUR 15 000 000, whichever is higher (Article 101).", "expected_evidence": "3 % of their annual total worldwide turnover", "answerable": true}
{"id": "q05", "type": "definition", "question": "How does the AI Act define an 'AI system'?", "expected_answer": "A machine-based system designed to operate with varying levels of autonomy, that may exhibit adaptiveness after deployment, and that infers from its input how to generate outputs such as predictions, content, recommendations or decisions that can influence physical or virtual environments (Article 3(1)).", "expected_evidence": "may exhibit adaptiveness after deployment", "answerable": true}
{"id": "q06", "type": "definition", "question": "Who is a 'provider' under the AI Act?", "expected_answer": "A natural or legal person, public authority, agency or other body that develops an AI system or general-purpose AI model (or has one developed) and places it on the market or puts it into service under its own name or trademark, whether for payment or free of charge (Article 3(3)).", "expected_evidence": "under its own name or trademark, whether for payment or free of charge", "answerable": true}
{"id": "q07", "type": "definition", "question": "Who counts as a deployer under the AI Act?", "expected_answer": "A natural or legal person, public authority, agency or other body using an AI system under its authority, except where the AI system is used in the course of a personal non-professional activity (Article 3(4)).", "expected_evidence": "personal non-professional activity", "answerable": true}
{"id": "q08", "type": "prohibition", "question": "Can an employer use AI to detect the emotions of its employees?", "expected_answer": "No. AI systems that infer emotions of natural persons in the workplace or education institutions are prohibited, except where intended for medical or safety reasons (Article 5(1)(f)).", "expected_evidence": "infer emotions of a natural person in the areas of workplace and education institutions", "answerable": true}
{"id": "q09", "type": "prohibition", "question": "Is it allowed to build a facial recognition database by scraping images from the internet?", "expected_answer": "No. AI systems that create or expand facial recognition databases through untargeted scraping of facial images from the internet or CCTV footage are prohibited (Article 5(1)(e)).", "expected_evidence": "untargeted scraping of facial images", "answerable": true}
{"id": "q10", "type": "transparency", "question": "What must providers ensure when people interact with an AI chatbot?", "expected_answer": "That the people concerned are informed that they are interacting with an AI system, unless this is obvious from the context (Article 50(1)).", "expected_evidence": "informed that they are interacting with an AI system", "answerable": true}
{"id": "q11", "type": "transparency", "question": "What must deployers do when they publish a deep fake?", "expected_answer": "Disclose that the content has been artificially generated or manipulated (Article 50(4)); lighter rules apply to evidently artistic, creative, satirical or fictional works.", "expected_evidence": "constituting a deep fake", "answerable": true}
{"id": "q12", "type": "cross-reference", "question": "Is an AI system used to screen job applications considered high-risk?", "expected_answer": "Yes. AI systems for recruitment or selection, including analysing and filtering job applications and evaluating candidates, are listed as high-risk in Annex III (employment, workers' management and access to self-employment).", "expected_evidence": "to analyse and filter job applications", "answerable": true}
{"id": "q13", "type": "cross-reference", "question": "Is AI used for credit scoring of individuals high-risk?", "expected_answer": "Yes. AI systems used to evaluate the creditworthiness of natural persons or establish their credit score are high-risk under Annex III, except AI systems used to detect financial fraud.", "expected_evidence": "evaluate the creditworthiness of natural persons", "answerable": true}
{"id": "q14", "type": "cross-reference", "question": "Does the AI Act treat AI used to price life insurance as high-risk?", "expected_answer": "Yes. AI systems for risk assessment and pricing in relation to natural persons in life and health insurance are high-risk under Annex III.", "expected_evidence": "life and health insurance", "answerable": true}
{"id": "q15", "type": "cross-reference", "question": "When is an AI system listed in Annex III not considered high-risk?", "expected_answer": "When it does not pose a significant risk of harm, for example because it performs a narrow procedural task, improves the result of a previously completed human activity, detects decision-making patterns without replacing human assessment, or performs a preparatory task (Article 6(3)). Systems that profile natural persons are always high-risk.", "expected_evidence": "narrow procedural task", "answerable": true}
{"id": "q16", "type": "cross-reference", "question": "Can an Annex III system that performs profiling of natural persons escape the high-risk classification?", "expected_answer": "No. An Annex III AI system that performs profiling of natural persons is always considered high-risk (Article 6(3)).", "expected_evidence": "performs profiling of natural persons", "answerable": true}
{"id": "q17", "type": "obligation", "question": "What does the AI Act require regarding human oversight of high-risk AI systems?", "expected_answer": "They must be designed and developed, including with appropriate human-machine interface tools, so they can be effectively overseen by natural persons while in use (Article 14).", "expected_evidence": "effectively overseen by natural persons", "answerable": true}
{"id": "q18", "type": "obligation", "question": "Must an employer tell workers before using a high-risk AI system at the workplace?", "expected_answer": "Yes. Deployers who are employers must inform workers' representatives and the affected workers that they will be subject to the high-risk AI system (Article 26).", "expected_evidence": "inform workers’ representatives and the affected workers", "answerable": true}
{"id": "q19", "type": "obligation", "question": "Who has to carry out a fundamental rights impact assessment?", "expected_answer": "Deployers that are bodies governed by public law or private entities providing public services, and deployers of high-risk AI systems for creditworthiness/credit scoring and life and health insurance pricing (Annex III points 5(b) and (c)), before deploying the system (Article 27).", "expected_evidence": "bodies governed by public law, or are private entities providing public services", "answerable": true}
{"id": "q20", "type": "obligation", "question": "When is a general-purpose AI model presumed to have high-impact capabilities?", "expected_answer": "When the cumulative amount of computation used for its training, measured in floating point operations, is greater than 10^25 (Article 51(2)).", "expected_evidence": "cumulative amount of computation used for its training", "answerable": true}
{"id": "q21", "type": "obligation", "question": "What must general-purpose AI model providers publish about their training data?", "expected_answer": "A sufficiently detailed summary about the content used for training the model, according to a template provided by the AI Office (Article 53(1)(d)).", "expected_evidence": "sufficiently detailed summary about the content used for training", "answerable": true}
{"id": "q22", "type": "scope", "question": "Does the AI Act apply to AI systems used for military purposes?", "expected_answer": "No. It does not apply to AI systems placed on the market, put into service or used exclusively for military, defence or national security purposes (Article 2(3)).", "expected_evidence": "exclusively for military, defence or national security purposes", "answerable": true}
{"id": "q23", "type": "scope", "question": "Does the AI Act apply to research and development of AI before it is placed on the market?", "expected_answer": "No. It does not apply to research, testing or development activity regarding AI systems or models before they are placed on the market or put into service; testing in real-world conditions is not covered by that exclusion (Article 2(8)).", "expected_evidence": "research, testing or development activity regarding AI systems or AI models", "answerable": true}
{"id": "q24", "type": "timeline-amended", "question": "From when do the obligations for high-risk AI systems listed in Annex III apply?", "expected_answer": "From 2 December 2027, as amended by the AI Omnibus (Regulation (EU) 2026/1744); the original Act said 2 August 2026 (Article 113).", "expected_evidence": "2 December 2027", "answerable": true}
{"id": "q25", "type": "timeline-amended", "question": "From when do the high-risk rules apply to AI systems covered by the product legislation in Annex I?", "expected_answer": "From 2 August 2028 for AI systems classified as high-risk under Article 6(1) and Annex I, as amended by the AI Omnibus (Article 113).", "expected_evidence": "2 August 2028", "answerable": true}
{"id": "q26", "type": "timeline", "question": "When did the AI Act's prohibitions on AI practices start to apply?", "expected_answer": "From 2 February 2025, when Chapters I and II apply (Article 113), with some later-added prohibitions applying from a later date.", "expected_evidence": "2 February 2025", "answerable": true}
